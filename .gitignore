# transient in-flight fleet state (resumable polling); never commit
companies/.fleet-state.json

# per-company runtime state lives on disk only, not in git
companies/*/

# OAuth client JSONs for custom transfer apps (dropbox/google); local only
companies/.oauth-client-*.json

# generated fleet dashboard (rebuilt by report-all)
reports/index.html
__pycache__/
*.pyc
.DS_Store
.preview/
.idea/

# sas-mint needs the Azure SDK (the rest of the harness is stdlib-only); local venv
scripts/sas-mint/.venv/

# minted credential zips never belong in git
*-sas.zip
